{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "crons": [
    {
      "path": "/api/cron/token-expiry-reminders",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/weekly-engagement-digest",
      "schedule": "0 4 * * 1"
    },
    {
      "path": "/api/cron/no-topup-triggers",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/engagement-triggers",
      "schedule": "30 5 * * *"
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
