# --- APP ---
# Local: http://localhost:3000
# Production (Vercel): https://www.jobtoken.co.ke
APP_URL="http://localhost:3000"

# --- SUPABASE ---
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-public-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-secret-service-role-key"
# OTP password reset hashes codes with this or SUPABASE_SERVICE_ROLE_KEY (see server/password-reset-otp.ts)
# PASSWORD_RESET_OTP_SECRET="long-random-string"

# (Optional) Legacy Supabase email recovery links are unused if you only use OTP reset; you can remove
# /reset-password from Supabase Dashboard → Authentication → Redirect URLs if desired.

# --- EMAIL (Zeptomail is default when ZEPTOMAIL_TOKEN is set) ---
ZEPTOMAIL_TOKEN="Zoho-enczapikey your-zeptomail-send-mail-token"
ZEPTOMAIL_FROM_ADDRESS="admin@jobtoken.co.ke"
ZEPTOMAIL_FROM_NAME="JobToken"

# To use SMTP instead: EMAIL_PROVIDER=smtp and fill SMTP_* below
# EMAIL_PROVIDER="smtp"
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="user@example.com"
SMTP_PASS="your-smtp-password"
SMTP_SECURE="false"
SMTP_FROM="JobToken <noreply@yourdomain.com>"
# EMAIL_FROM="JobToken <noreply@yourdomain.com>"

# --- M-PESA DARAJA (STK Push) ---
# Production base URL is https://api.safaricom.co.ke — or set MPESA_BASE_URL explicitly.
# MPESA_ENV="sandbox"
MPESA_CONSUMER_KEY="GD0Jej2cvGgH3KCjLo9UyTWJjA9BmaWkGl4baRrAOMwbargy"
MPESA_CONSUMER_SECRET="6MXSdwAd5gLcV2hzgQof9zGGVtLC0lneyC9Y1BJyV73sDeWfAeTAqAT99UzmACSY"
MPESA_SHORTCODE="4681373"
# Buy Goods Till: LNMO short code above + Till number below (PartyB). Do NOT put Till in MPESA_SHORTCODE.
MPESA_PARTYB="5445878"
MPESA_PASSKEY="your-live-lnmo-passkey"
# Full public URL to this API route, e.g. https://jobtoken-portal-poc.vercel.app/api/mpesa/callback
MPESA_CALLBACK_URL="https://jobtoken-portal-poc.vercel.app/api/mpesa/callback"
# Optional: CustomerPayBillOnline (default) or CustomerBuyGoodsOnline for Till-style flows
# MPESA_TRANSACTION_TYPE="CustomerPayBillOnline"

# JSON array of { "kes": number, "tokens": number } — optional; defaults are 100/5, 500/25, 1000/50
# TOKEN_PACKS_JSON='[{"kes":100,"tokens":5},{"kes":500,"tokens":25},{"kes":1000,"tokens":50}]'
# Flat rate: 1 token = MPESA_KES_PER_TOKEN KES (default 20). All packs use this same rate — no volume discounts.
# MPESA_KES_PER_TOKEN="20"
# MPESA_MIN_TOPUP_KES="100"
# MPESA_MAX_TOPUP_KES="150000"
# Days wallet tokens stay valid after each top-up or earnings redemption (default 10).
# WALLET_TOKEN_EXPIRY_DAYS="10"
# Days before expiry to send reminder email (default 2).
# WALLET_TOKEN_EXPIRY_REMINDER_DAYS="2"
# Secret for Vercel Cron (Authorization: Bearer <CRON_SECRET>).
# CRON_SECRET="generate-a-long-random-string"

# --- DEV: simulated wallet top-up (no real M-Pesa) ---
MPESA_SIMULATE="false"
# When true, POST /api/mpesa/simulate-callback JSON { "checkoutRequestId": "<from transactions row>" , "amountKes": 100 } runs the same credit logic as the real callback.

# --- FRONTEND (Vite) ---
# Show "Dev: simulate top-up" when server has MPESA_SIMULATE=true
VITE_ALLOW_SIMULATE_TOPUP="false"

# --- EMPLOYER MONETIZATION (tokens from employer wallet) ---
EMPLOYER_POSTING_FEE_TOKENS="0"
# Fallback if platform_settings.feature_job_tokens is missing (admin sets live value in Admin portal).
FEATURE_JOB_TOKENS="2"

# --- EARNINGS (KES ledger, server) ---
# Withdrawal requests open on the first Tuesday of each month from August 2026 (see server/withdrawal-window.ts).
# Minimum KES per withdrawal request (default 5000).
# EARNINGS_MIN_WITHDRAWAL_KES="5000"
# Set to true to re-enable earnings → token redeem and gift (disabled by default).
# EARNINGS_TOKEN_EXCHANGE_ENABLED="false"

# --- REWARD CAP (sustainability formula) ---
# Platform margin (0–1). R_max = (submit_cost_tokens * KES_PER_TOKEN * (1 - MARGIN)) / PASS_RATE
# PLATFORM_MARGIN="0.40"
# Target pass rate for reward cap calculations (0–1).
# TARGET_PASS_RATE="0.50"

# --- GEMINI AI QUALITY CHECK ---
GEMINI_API_KEY="your-gemini-api-key"
# Set to true to enable automatic AI quality analysis on prompt submissions (uses Gemini 2.0 Flash free tier).
# GEMINI_QUALITY_CHECK_ENABLED="false"
